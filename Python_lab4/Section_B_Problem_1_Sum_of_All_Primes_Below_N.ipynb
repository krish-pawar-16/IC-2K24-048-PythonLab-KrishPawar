

import time

def sum_primes_naive(n):
    total = 0
    for x in range(2, n):
        is_prime = True
        for d in range(2, x):
            if x % d == 0:
                is_prime = False
                break
        if is_prime:
            total += x
    return total



for n, expected in [(10, 17), (30, 129), (100, 1060), (1000, 76127)]:
    got = sum_primes_naive(n)
    print(n, got, "PASS" if got == expected else "FAIL")


n = 50000
start = time.time()
result = sum_primes_naive(n)
end = time.time()
print(f"N = {n}, sum = {result}, time = {end - start:.4f} s")
     
10 17 PASS
30 129 PASS
100 1060 PASS
1000 76127 PASS
